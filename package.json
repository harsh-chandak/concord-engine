{
  "name": "orchestraguard",
  "version": "0.2.1",
  "description": "Agent orchestration never drifts. A decision log for hierarchical coding agents that refuses a contradicting decision \u2014 deterministic, no model call.",
  "keywords": [
    "ai-agents",
    "agent-orchestration",
    "multi-agent",
    "coding-agents",
    "consistency",
    "decision-log",
    "claude-code",
    "codex",
    "coordination"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "orchestraguard": "dist/cli.js",
    "orchestraguard-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SKILL.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "node scripts/prepublish-guard.mjs && npm run build && npm test"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "author": "Harsh N. Chandak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harsh-chandak/orchestraguard.git"
  },
  "homepage": "https://github.com/harsh-chandak/orchestraguard#readme",
  "bugs": {
    "url": "https://github.com/harsh-chandak/orchestraguard/issues"
  },
  "exports": {
    ".": "./dist/index.js",
    "./mcp": "./dist/mcp.js"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "mcpName": "io.github.harsh-chandak/orchestraguard"
}
