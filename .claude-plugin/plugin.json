{
  "name": "orchestraguard",
  "displayName": "orchestraguard",
  "version": "0.2.0",
  "description": "Agents that can't contradict each other. A decision log for hierarchical coding agents, with deterministic contradiction detection and an escalation ladder.",
  "author": {
    "name": "Harsh N. Chandak",
    "url": "https://harsh-chandak.com"
  },
  "homepage": "https://github.com/harsh-chandak/orchestraguard",
  "repository": "https://github.com/harsh-chandak/orchestraguard",
  "documentationUrl": "https://github.com/harsh-chandak/orchestraguard#readme",
  "supportUrl": "https://github.com/harsh-chandak/orchestraguard/issues",
  "license": "MIT",
  "keywords": [
    "ai-agents",
    "agent-orchestration",
    "multi-agent",
    "coordination",
    "consistency"
  ],
  "userConfig": {
    "decisions_dir": {
      "type": "directory",
      "title": "Decision log directory",
      "description": "Where decisions and conflicts are stored. Defaults to .orchestraguard in the project. Commit it \u2014 the log is the shared contract.",
      "required": false
    }
  },
  "mcpServers": {
    "orchestraguard": {
      "command": "npx",
      "args": [
        "-y",
        "-p",
        "orchestraguard",
        "-p",
        "@modelcontextprotocol/sdk",
        "orchestraguard-mcp"
      ],
      "env": {
        "ORCHESTRAGUARD_DIR": "${user_config.decisions_dir}"
      }
    }
  }
}
